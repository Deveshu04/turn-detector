.venv/
__pycache__/
*.pyc
.pytest_cache/
.idea/
.ruff_cache/

# local data artifacts (audio + intermediate); manifests and corpus text stay tracked
data/
synth/output/audio/
synth/output/boundaries/
synth/output/**/*.zip
synth/output/kaggle_upload/
*.ckpt
*.pt
!models/**/*.pt

# large HF caches
.cache/

# build artifact: assembled HF Space (python -m tools.build_space)
space/

# error-analysis outputs (regenerable from run dirs)
**/analysis/
experiments/kaggle_output/
experiments/run_*/*.pt
experiments/run_*/*.onnx
experiments/run_*/*.log

# push staging (regenerated by tools/push_kaggle.py on every push)
notebooks/push/

# browser demo: the int8 exports + config.json ship, the fp32 sources do not
webdemo/models/*_fp32.onnx
